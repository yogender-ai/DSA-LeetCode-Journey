1. Two Sum --python

class Solution:
    def twoSum(self, nums: List[int], target: int) -> List[int]:
        left=0
        right=len(nums)-1
        new=sorted(nums)
        while(left!=right):
            sum=new[left]+new[right]
            if(sum==target and left!=right):
                break
            elif(sum<target):
                left+=1
            else:
                right-=1
        pleft=nums.index(new[left])
        pright=nums.index(new[right])
        if pleft==pright:
            pright=nums.index(new[right],pleft+1)
        return [pleft,pright]
            


